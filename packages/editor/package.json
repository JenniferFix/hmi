{
  "name": "@fixtech/hmi-editor",
  "version": "0.0.1",
  "description": "Just Another HMI - Create HMI panels for use with Allen Bradley PLCs",
  "main": "./out/main/index.js",
  "author": "Jennifer Fix",
  "homepage": "https://jenniferfix.ca",
  "license": "MIT",
  "scripts": {
    "cleandist": "pnpm rimraf out",
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "cross-env DB_SEEDING=true electron-vite dev",
    "test": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fixtech/hmi-websocket": "workspace:*",
    "@fixtech/node-red-contrib-fixtech-hmi-websocket": "workspace:*",
    "@fontsource/noto-sans": "^5.1.1",
    "@hookform/resolvers": "^5.0.1",
    "@libsql/client": "^0.15.7",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-form": "^1.12.0",
    "@tanstack/react-query": "^5.66.5",
    "@tanstack/react-router": "^1.105.0",
    "@tanstack/react-table": "^8.21.2",
    "@tanstack/router": "0.0.1-beta.53",
    "@tanstack/zod-form-adapter": "^0.42.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "dotenv-expand": "^12.0.1",
    "drizzle-orm": "^0.44.0",
    "drizzle-zod": "^0.8.2",
    "electron-window-state": "^5.0.3",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "next-themes": "^0.4.4",
    "node-red": "^4.0.9",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^3.0.2",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "use-resize-observer": "^9.1.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@tanstack/eslint-plugin-query": "^5.66.1",
    "@tanstack/react-query-devtools": "^5.66.5",
    "@tanstack/router-plugin": "^1.105.0",
    "@types/node": "^22.13.4",
    "@types/node-red": "^1.3.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.1",
    "electron": "^36.3.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "postcss": "^8.5.2",
    "prettier": "^3.5.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
